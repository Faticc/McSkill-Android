<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="@dimen/fragment_padding_medium">

    <View
        android:id="@+id/mcskill_install_menu"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_260sdp"
        android:background="@drawable/background_card"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.kdt.mcgui.MineEditText
        android:id="@+id/mcskill_install_client_id"
        android:layout_width="0dp"
        android:layout_height="@dimen/_37sdp"
        android:layout_marginHorizontal="@dimen/_25sdp"
        android:layout_marginTop="@dimen/_30sdp"
        android:hint="Client ID"
        android:imeOptions="flagNoExtractUi"
        android:inputType="number"
        android:textSize="@dimen/_16ssp"
        app:layout_constraintEnd_toEndOf="@+id/mcskill_install_menu"
        app:layout_constraintStart_toStartOf="@+id/mcskill_install_menu"
        app:layout_constraintTop_toTopOf="@+id/mcskill_install_menu" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/mcskill_install_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginHorizontal="@dimen/_25sdp"
        android:layout_marginTop="@dimen/padding_heavy"
        android:text="Install and register"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mcskill_install_client_id" />

    <TextView
        android:id="@+id/mcskill_install_status"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_25sdp"
        android:layout_marginTop="@dimen/padding_heavy"
        android:layout_marginBottom="@dimen/_20sdp"
        android:textColor="@android:color/white"
        android:textSize="@dimen/_12ssp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/mcskill_install_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mcskill_install_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
