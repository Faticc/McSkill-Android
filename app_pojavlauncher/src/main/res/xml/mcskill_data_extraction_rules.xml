<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) replacement for fullBackupContent. Same intent as
    mcskill_backup_rules.xml: never let the encrypted mcskill password prefs file (which also holds
    the androidx security-crypto Tink keysets) leave the device via cloud backup or device transfer.

    Everything else keeps the previous default behaviour (backed up / transferred).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="mcskill_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="mcskill_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
